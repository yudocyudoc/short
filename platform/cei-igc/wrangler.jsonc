{
  "name": "cei-igc-workbench-v02",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-10-21",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [
    {"binding": "IGC_DB", "database_name": "cei-igc-lab-v02", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations"}
  ],
  "r2_buckets": [{"binding": "IGC_ARTIFACTS", "bucket_name": "cei-igc-lab-v02"}],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_APPLICATION_AUD",
    "GITHUB_REPO": "yudocyudoc/short",
    "GITHUB_WORKFLOW": "igc-arena-probe.yml",
    "GITHUB_REF": "main"
  }
}

