getVersion();
loadModel(Modelica, {"4.0.0"});
loadModel(SystemDynamics, {"2.1.2"});
loadFile("../openmodelica-mto-s2/IGCS2MakeToOrder.mo");
loadFile("../molecular-design-loop-v1/IGCMolecules.mo");
loadFile("../composable-transit-v1/IGCTransitCore.mo");
loadFile("IGCInformationMolecules.mo");
loadFile("IGCObservationCore.mo");
loadFile("IGCObservationGraphs.mo");
loadFile("../noise-param-identifiability-v1/IGCStressWorlds.mo");
checkModel(IGCStressWorlds.FastDirect);
simulate(IGCStressWorlds.FastDirect, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="stress_FastDirect");
checkModel(IGCStressWorlds.FastTransitOnly);
simulate(IGCStressWorlds.FastTransitOnly, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="stress_FastTransitOnly");
checkModel(IGCStressWorlds.FastReportOnly);
simulate(IGCStressWorlds.FastReportOnly, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="stress_FastReportOnly");
checkModel(IGCStressWorlds.FastTransitAndReport);
simulate(IGCStressWorlds.FastTransitAndReport, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="stress_FastTransitAndReport");
checkModel(IGCStressWorlds.SlowDirect);
simulate(IGCStressWorlds.SlowDirect, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="stress_SlowDirect");
checkModel(IGCStressWorlds.SlowTransitOnly);
simulate(IGCStressWorlds.SlowTransitOnly, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="stress_SlowTransitOnly");
checkModel(IGCStressWorlds.SlowReportOnly);
simulate(IGCStressWorlds.SlowReportOnly, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="stress_SlowReportOnly");
checkModel(IGCStressWorlds.SlowTransitAndReport);
simulate(IGCStressWorlds.SlowTransitAndReport, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="stress_SlowTransitAndReport");
getErrorString();
