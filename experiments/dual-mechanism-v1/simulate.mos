getVersion();
loadModel(Modelica, {"4.0.0"});
loadModel(SystemDynamics, {"2.1.2"});
loadFile("../openmodelica-mto-s2/IGCS2MakeToOrder.mo");
loadFile("../molecular-design-loop-v1/IGCMolecules.mo");
loadFile("../composable-transit-v1/IGCTransitCore.mo");
loadFile("IGCInformationMolecules.mo");
loadFile("IGCObservationCore.mo");
loadFile("IGCObservationGraphs.mo");
loadFile("IGCObservationScenarios.mo");
checkModel(IGCObservationGraphs.Direct);
checkModel(IGCObservationGraphs.TransitOnly);
checkModel(IGCObservationGraphs.ReportOnly);
checkModel(IGCObservationGraphs.TransitAndReport);
checkModel(IGCObservationScenarios.ZeroDirect);
checkModel(IGCObservationScenarios.ZeroTransitOnly);
checkModel(IGCObservationScenarios.ZeroReportOnly);
checkModel(IGCObservationScenarios.ZeroTransitAndReport);
simulate(IGCObservationScenarios.ZeroDirect, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="zero_Direct");
simulate(IGCObservationScenarios.ZeroTransitOnly, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="zero_TransitOnly");
simulate(IGCObservationScenarios.ZeroReportOnly, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="zero_ReportOnly");
simulate(IGCObservationScenarios.ZeroTransitAndReport, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="zero_TransitAndReport");
simulate(IGCObservationGraphs.Direct, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="pulse_Direct");
simulate(IGCObservationGraphs.TransitOnly, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="pulse_TransitOnly");
simulate(IGCObservationGraphs.ReportOnly, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="pulse_ReportOnly");
simulate(IGCObservationGraphs.TransitAndReport, startTime=0, stopTime=8, numberOfIntervals=64, method="euler", outputFormat="csv", fileNamePrefix="pulse_TransitAndReport");
getErrorString();
