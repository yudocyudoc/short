getVersion();
loadModel(Modelica, {"4.0.0"});
loadModel(SystemDynamics, {"2.1.2"});
loadFile("../openmodelica-mto-s2/IGCS2MakeToOrder.mo");
loadFile("../openmodelica-s1-parity/IGCS1Parity.mo");
loadFile("IGCSelected.mo");
checkModel(IGCSelected.Candidate);
simulate(IGCSelected.Candidate, startTime=0, stopTime=4, numberOfIntervals=16, method="euler", outputFormat="csv", fileNamePrefix="policy_candidate");
getErrorString();
