  "cases": [
    {
      "id": "EPI02-SURVIVE",
      "question": "¿Existe un solo stock de pedidos pendientes o dos acumulaciones funcionales?",
      "hypotheses": [
        {
          "id": "epi02:s1:h:one",
          "label": "Una cola funcional"
        },
        {
          "id": "epi02:s1:h:two",
          "label": "Dos colas funcionales"
        }
      ],
      "records": [
        {
          "id": "epi02:s1:doc:01",
          "text": "Resumen interno: una sola cola de tickets de producción."
        },
        {
          "id": "epi02:s1:doc:02",
          "text": "Bitácora: movimientos entre recepción y procesamiento; la auditoría posterior detecta códigos duplicados."
        },
        {
          "id": "epi02:s1:doc:03",
          "text": "Plano fechado: zonas separadas de admisión y procesamiento."
        },
        {
          "id": "epi02:s1:doc:04",
          "text": "Entrevista de supervisión; posterior comprobación cuestiona el recuerdo de fechas."
        }
      ],
      "assumptions": [
        {
          "id": "epi02:s1:a:single-report",
          "text": "El resumen de cola única es fiable",
          "source_ids": [
            "epi02:s1:doc:01"
          ]
        },
        {
          "id": "epi02:s1:a:two-zones-are-stocks",
          "text": "Las zonas separadas representan acumulaciones funcionales distintas",
          "source_ids": [
            "epi02:s1:doc:03"
          ]
        },
        {
          "id": "epi02:s1:a:transfer-log",
          "text": "Los movimientos registrados son distintos y fiables",
          "source_ids": [
            "epi02:s1:doc:02"
          ]
        },
        {
          "id": "epi02:s1:a:layout-current",
