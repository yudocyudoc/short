    {
      "id": "EPI02-LOSS",
      "question": "¿Los pedidos se administran en un pool único o a través de dos colas seriales?",
      "hypotheses": [
        {
          "id": "epi02:s2:h:one",
          "label": "Pool único"
        },
        {
          "id": "epi02:s2:h:two",
          "label": "Dos colas seriales"
        }
      ],
      "records": [
        {
          "id": "epi02:s2:doc:01",
          "text": "El informe de tickets dice que la cola de despacho es única."
        },
        {
          "id": "epi02:s2:doc:02",
          "text": "Registro automático de tránsitos: la auditoría posterior revela que intercambios entre estaciones fueron agregaciones contables."
        },
        {
          "id": "epi02:s2:doc:03",
          "text": "Análisis de retrasos atribuye dos esperas diferentes; luego se detecta un sesgo en la marca temporal."
        },
        {
          "id": "epi02:s2:doc:04",
          "text": "Registro de asignación de trabajo muestra una lista compartida de pendientes."
        }
      ],
      "assumptions": [
        {
          "id": "epi02:s2:a:two-zones-are-stocks",
          "text": "Las dos ubicaciones suponen stocks diferenciados",
          "source_ids": [
            "epi02:s2:doc:02"
          ]
        },
        {
          "id": "epi02:s2:a:transfer-log",
          "text": "El registro de tránsitos es válido",
          "source_ids": [
            "epi02:s2:doc:02"
          ]
        },
        {
          "id": "epi02:s2:a:lag-study",
          "text": "Los desfases temporales identifican dos esperas distintas",
          "source_ids": [
            "epi02:s2:doc:03"
          ]
        },
        {
          "id": "epi02:s2:a:unified-report",
          "text": "El informe de cola única es fiable",
          "source_ids": [
            "epi02:s2:doc:01"
          ]
        },
        {
          "id": "epi02:s2:a:dispatch-log",
          "text": "El registro de asignación representa pendientes reales",
          "source_ids": [
            "epi02:s2:doc:04"
          ]
        }
