getVersion();
loadModel(Modelica, {"4.0.0"});
loadModel(SystemDynamics, {"2.1.2"});
loadFile("../openmodelica-mto-s2/IGCS2MakeToOrder.mo");
checkModel(IGCS2MakeToOrder.Components);
simulate(IGCS2MakeToOrder.Components, startTime=0, stopTime=10, numberOfIntervals=40, method="euler", outputFormat="csv", fileNamePrefix="s2_reference");
getErrorString();
